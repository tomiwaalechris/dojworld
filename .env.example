# Fresh dedicated Dojworld Supabase project. These two values are public.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DOJWORLD_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server only: Supabase Settings > API Keys > Secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Generate locally with: openssl rand -hex 32
BOOKING_RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Use your real HTTPS domain in production.
SITE_URL=http://localhost:3000
# Header that your deployment platform overwrites with the real client IP.
BOOKING_CLIENT_IP_HEADER=x-forwarded-for

# Start with a Paystack TEST secret. Leave empty to allow only approved arrival requests.
PAYSTACK_SECRET_KEY=

# Booking email connection (Resend). Verify a domain/sender in Resend first.
# Server-only values. The sender must belong to your verified domain.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
# Random secret of at least 32 characters for the scheduled booking worker.
# Production scheduler: POST /api/booking/tasks with Authorization: Bearer <secret>.
# A configured secret prepares the endpoint; a scheduler must still be enabled separately.
BOOKING_WORKER_SECRET=
